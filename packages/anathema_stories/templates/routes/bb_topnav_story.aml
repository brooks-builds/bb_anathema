vstack [height: 40]
	@BBHeading [text: "BBTopNav"]
	padding [padding: 1]
		@BBTopNav [app_name: state.app_name]
	@BBHeading [text: "Attributes"]
	@BBInput (on_change->app_name_changed) [initial_value: state.app_name, label: "app_name"]
	@BBButton (click->generate_aml) [label: "generate aml"]
	if state.show_code
		@BBBlock (copied->code_copied) [value: state.code, copy: true, header: true]
