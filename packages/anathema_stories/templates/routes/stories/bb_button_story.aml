vstack
	@BBHeading [text: "BBButton Story"]
	if state.show_preview
		@BBButton (click->toggle_preview) [label: "Turn off preview"]
	else
		@BBButton (click->toggle_preview) [label: "Turn on preview"]
	if state.show_preview
		padding [top: 1]
			@BBButton [label: state.attribute_label, disabled: state.attribute_disabled]
		
	@BBHeading [text: "Attributes"]
	@BBInput (on_change->set_label) [label: "label", initial_value: state.attribute_label]
	@BBCheckbox (on_change->toggle_disabled) [label: "disabled"]


	@BBHeading [text: "Events"]
	text "click -> ()"
	if state.show_aml
		@BBBlock (copied->remove_aml) [value: state.aml, header: true, copy: true, title: "BBButton AML"]
	else 
		@BBButton (click->show_aml) [label: "generate aml"]


