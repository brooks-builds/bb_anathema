switch state.path
	case "/": @home
	case "/stories/bb_topnav": @TopNavStory
	case "/snippets/new_anathema": @new_anathema_snippet
	case "/snippets/new_snippet": @new_snippet [width: attributes.width, height: attributes.height]
	case "/snippets/new_component": @new_component [width: attributes.width, height: attributes.height]
	case "/stories/bbbock_story": @BBBlockStory [width: attributes.width, height: attributes.height]
	case "/snippets/creating_a_component": @creating_a_component [width: attributes.width, height: attributes.height]
	case "/stories/bb_button": @BBButtonStory [width: attributes.width, height: attributes.height]
	case "/stories/bb_checkbox": @BBCheckboxStory [width: attributes.width, height: attributes.height]
	case "/stories/bb_heading": @BBHeadingStory [width: attributes.width, height: attributes.height]
	case "/stories/bb_input": @BBInputStory [width: attributes.width, height: attributes.height]
	case "/stories/bb_link": @BBLinkStory [width: attributes.width, height: attributes.height]

