vstack
	@BBTopNav [app_name: "BB Anathema Stories"]
	hstack
		border [sides: "right", width: state.left_nav_width, height: state.height]
			vstack
				@BBHeading [text: "Snippets"]
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/snippets/new_anathema"]
						text "New Anathema"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/snippets/new_snippet"]
						text "New Snippet"
				@BBHeading [text: "Components", padding_top: 1]
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_topnav"]
						text "BBTopNav"
		container [width: state.main_width, height: state.height]
			@Router
