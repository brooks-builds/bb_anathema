vstack
	@BBTopNav [app_name: "BB Anathema Stories"]
	hstack
		border [sides: "right", width: state.left_nav_width, height: state.height]
			vstack
				@BBHeading [text: "Snippets"]
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/snippets/new_anathema"]
						text "New Anathema"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/snippets/new_snippet"]
						text "New Snippet Struct"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/snippets/new_component"]
						text "New Story Component"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/snippets/creating_a_component"]
						text "Creating a Component"

				@BBHeading [text: "Components", padding_top: 1]

				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bbbock_story"]
						text "BBBlock"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_button"]
						text "BBButton"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_checkbox"]
						text "BBCheckbox"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_heading"]
						text "BBHeading"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_input"]
						text "BBInput"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_link"]
						text "BBLink"
				padding [left: 2]
					@BBLink (nav_to->nav_to) [nav_to: "/stories/bb_topnav"]
						text "BBTopNav"
		container [width: state.main_width, height: state.height]
			@Router [width: state.main_width, height: state.height]
